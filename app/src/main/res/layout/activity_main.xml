<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_dark"
    tools:context=".MainActivity">

    <!-- ========== Loading Screen ========== -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/surface_dark"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent_blue" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_text"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ========== Main UI ========== -->
    <LinearLayout
        android:id="@+id/layoutMainUI"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark"
            app:tabTextColor="@color/tab_unselected"
            app:tabSelectedTextColor="@color/accent_blue"
            app:tabIndicatorColor="@color/accent_blue"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabGravity="fill" />

        <!-- Tab Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ===== TAB 1: Structural Model ===== -->
            <ScrollView
                android:id="@+id/layoutStructuralModel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Card: Node Definition -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/card_bg_dark"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/card_nodes"
                                android:textColor="@color/accent_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <EditText
                                    android:id="@+id/etNodeId"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_node_id"
                                    android:inputType="number"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etNodeX"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_x"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etNodeY"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_y"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etNodeZ"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_z"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <CheckBox
                                android:id="@+id/cbFixed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fixed Support"
                                android:textColor="@color/on_surface"
                                android:buttonTint="@color/accent_blue"
                                android:layout_marginTop="4dp" />

                            <Button
                                android:id="@+id/btnAddNode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_add_node"
                                android:layout_marginTop="8dp"
                                android:backgroundTint="@color/accent_blue" />

                            <TextView
                                android:id="@+id/tvNodeList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="monospace"
                                android:textColor="@color/on_surface_dim"
                                android:textSize="11sp"
                                android:text="No nodes defined yet." />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card: Material & Section -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/card_bg_dark"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/card_materials"
                                android:textColor="@color/accent_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinnerMaterial"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="@color/on_surface" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <EditText
                                    android:id="@+id/etEModulus"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_e_modulus"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etFy"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_fy"
                                    android:inputType="numberDecimal"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnAssignMaterial"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_assign_material"
                                android:layout_marginTop="8dp"
                                android:backgroundTint="@color/accent_blue" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card: Load Patterns -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/card_bg_dark"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/card_loads"
                                android:textColor="@color/accent_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinnerLoadType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:backgroundTint="@color/on_surface" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <EditText
                                    android:id="@+id/etLoadNodeId"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_node_id"
                                    android:inputType="number"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etFx"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_fx"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etFyLoad"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_fy_load"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="4dp" />

                                <EditText
                                    android:id="@+id/etFzLoad"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:hint="@string/hint_fz"
                                    android:inputType="numberDecimal|numberSigned"
                                    android:textColor="@color/on_surface"
                                    android:textColorHint="@color/on_surface_dim"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btnApplyLoad"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_apply_load"
                                android:layout_marginTop="8dp"
                                android:backgroundTint="@color/accent_orange" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card: Script Editor -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        app:cardBackgroundColor="@color/card_bg_dark"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/card_script"
                                android:textColor="@color/accent_blue"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etScriptEditor"
                                android:layout_width="match_parent"
                                android:layout_height="200dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/terminal_bg"
                                android:fontFamily="monospace"
                                android:gravity="top|start"
                                android:hint="@string/hint_script"
                                android:inputType="textMultiLine"
                                android:scrollbars="vertical"
                                android:textColor="@color/terminal_green"
                                android:textColorHint="#336633"
                                android:textSize="12sp"
                                android:padding="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <Button
                                    android:id="@+id/btnRunTcl"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_run_tcl"
                                    android:backgroundTint="@color/accent_blue"
                                    android:layout_marginEnd="4dp"
                                    android:textSize="12sp" />

                                <Button
                                    android:id="@+id/btnRunPython"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_run_python"
                                    android:backgroundTint="@color/accent_green"
                                    android:layout_marginEnd="4dp"
                                    android:textSize="12sp" />

                                <Button
                                    android:id="@+id/btnImport"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_import"
                                    android:backgroundTint="@color/on_surface_dim"
                                    android:layout_marginEnd="4dp"
                                    android:textSize="12sp" />

                                <Button
                                    android:id="@+id/btnExport"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_export"
                                    android:backgroundTint="@color/on_surface_dim"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvScriptOutput"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/terminal_bg"
                                android:fontFamily="monospace"
                                android:padding="8dp"
                                android:scrollbars="vertical"
                                android:text="System log output..."
                                android:textColor="@color/terminal_green"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>

            <!-- ===== TAB 2: 3D Viewer ===== -->
            <LinearLayout
                android:id="@+id/layoutViewer3D"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/containerGL"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/tvViewerOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="#CC1C1C1E"
                        android:fontFamily="monospace"
                        android:padding="10dp"
                        android:text="SAP2000 Structural Summary\nNodes: 0 | Elements: 0\nStatus: Ready"
                        android:textColor="@color/terminal_green"
                        android:textSize="11sp" />
                </FrameLayout>

                <!-- Viewer Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_bg_dark"
                    android:padding="8dp">

                    <!-- Primary Action Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/btnCalculate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ CALCULAR ESTRUCTURA"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:padding="6dp"
                            android:backgroundTint="@color/accent_green"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnExportPdfViewer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📄 REPORTE PDF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:padding="6dp"
                            android:backgroundTint="@color/accent_orange" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <Button
                            android:id="@+id/btnWireframe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_wireframe"
                            android:textSize="10sp"
                            android:padding="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:backgroundTint="@color/accent_blue"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnDeformed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_deformed"
                            android:textSize="10sp"
                            android:padding="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:backgroundTint="@color/accent_orange"
                            android:layout_marginEnd="4dp" />

                        <Button
                            android:id="@+id/btnDiagrams"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Diagramas M/V"
                            android:textSize="10sp"
                            android:padding="4dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:backgroundTint="@color/purple_500" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekDeformScale"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/accent_blue"
                        android:thumbTint="@color/accent_blue" />

                    <TextView
                        android:id="@+id/tvScaleLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deformation Scale: 1.0x"
                        android:textColor="@color/on_surface_dim"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== TAB 3: Terminal & Log ===== -->
            <LinearLayout
                android:id="@+id/layoutTerminal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Terminal Container -->
                <FrameLayout
                    android:id="@+id/containerTerminal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>

        </FrameLayout>
    </LinearLayout>

</LinearLayout>