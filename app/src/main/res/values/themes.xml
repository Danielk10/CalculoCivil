<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CalculoCivil" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">#FF0D47A1</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="tabStyle">@style/CalculoCivil.TabLayout</item>
    </style>

    <style name="CalculoCivil.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">@color/tab_unselected</item>
        <item name="tabSelectedTextColor">@color/accent_blue</item>
        <item name="tabIndicatorColor">@color/accent_blue</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabBackground">@color/surface_dark</item>
    </style>

    <style name="CardDark" parent="">
        <item name="android:background">@color/card_bg_dark</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>